source "https://rubygems.org"

# Jekyll and plugins
gem "jekyll", "~> 4.4.1"
gem "bundler", "~> 2.7.2"

# The deploy workflow runs plain `bundle exec jekyll build`, not the restricted
# `github-pages` gem, so arbitrary plugins are allowed here.
# Gemfile.lock MUST be committed alongside any change to this file -- the
# workflow uses `bundler-cache: true` and fails on a stale lockfile.
gem "jekyll-sitemap", "~> 1.4"
gem "jekyll-seo-tag", "~> 2.8"
